rules_version = '2';

// Paste these rules in Firebase console > Firestore Database > Rules, then press Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // True when the profile users/{userId} belongs to the person who is signed in.
    function ownsProfile(userId) {
      return get(/databases/$(database)/documents/users/$(string(userId))).data.uid == request.auth.uid;
    }

    // Profiles: everybody signed in can read them, each person creates and edits only their own.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      // Only the profile details can change (not the id, username, email or owner).
      allow update: if signedIn() && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.id == resource.data.id
                    && request.resource.data.username == resource.data.username
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.fullName.size() > 0
                    && request.resource.data.fullName.size() <= 50
                    && request.resource.data.get('bio', '').size() <= 160
                    && request.resource.data.get('location', '').size() <= 30
                    && request.resource.data.get('website', '').size() <= 100
                    && request.resource.data.get('avatarUrl', '').size() <= 150000
                    && request.resource.data.get('bannerUrl', '').size() <= 300000
                    // Nobody can verify themselves: it is changed only from the console.
                    && request.resource.data.get('verified', false) == resource.data.get('verified', false);
      allow delete: if false;
    }

    // Username -> email, so a person can sign in by username before being signed in.
    // It can be read one by one (get) but not listed. A username can only be created once.
    match /usernames/{username} {
      allow get: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // A person can only create follows where they are the follower.
    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn() && ownsProfile(request.resource.data.followerId);
      allow update: if false;
      allow delete: if signedIn() && ownsProfile(resource.data.followerId);
    }

    // A person can only like or repost as themselves, and the document id must be {userId}_{tweetId}.
    match /likes/{likeId} {
      allow read: if signedIn();
      allow create: if signedIn() && ownsProfile(request.resource.data.userId)
                    && likeId == string(request.resource.data.userId) + '_' + string(request.resource.data.tweetId);
      allow update: if false;
      allow delete: if signedIn() && ownsProfile(resource.data.userId);
    }

    match /reposts/{repostId} {
      allow read: if signedIn();
      allow create: if signedIn() && ownsProfile(request.resource.data.userId)
                    && repostId == string(request.resource.data.userId) + '_' + string(request.resource.data.tweetId);
      allow update: if false;
      allow delete: if signedIn() && ownsProfile(resource.data.userId);
    }

    // The saved tweets (bookmarks) are private: only their owner can read, create or delete them.
    match /bookmarks/{bookmarkId} {
      allow read: if signedIn() && ownsProfile(resource.data.userId);
      allow create: if signedIn() && ownsProfile(request.resource.data.userId)
                    && bookmarkId == string(request.resource.data.userId) + '_' + string(request.resource.data.tweetId);
      allow update: if false;
      allow delete: if signedIn() && ownsProfile(resource.data.userId);
    }

    // A person can only post tweets as themselves: up to 280 characters, with an optional small photo.
    // A tweet needs text or a photo. A reply is a tweet with the replyToId of the tweet it answers.
    match /tweets/{tweetId} {
      allow read: if signedIn();
      allow create: if signedIn() && ownsProfile(request.resource.data.userId)
                    && request.resource.data.text.size() <= 280
                    && (request.resource.data.text.size() > 0 || request.resource.data.get('imageUrl', '').size() > 0)
                    && request.resource.data.get('imageUrl', '').size() <= 350000;
      allow update, delete: if false;
    }
  }
}
